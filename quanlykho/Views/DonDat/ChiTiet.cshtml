@using quanlykho.Common.PhanQuyen
@using quanlykho.Features.XuatKho
@model DonDatChiTiet
@{
    ViewData["Title"] = $"Đơn đặt hàng {Model.Ma}";
    var laNguoiTao = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.MaNguoiTao || User.IsInRole(Vai.QuanTri);
    var choDatHang = User.IsInRole(Vai.QuanTri) || User.IsInRole(Vai.BanHang);
    var quanLy = User.IsInRole(Vai.QuanTri) || User.IsInRole(Vai.QuanLyKho);
}

<div class="tieu-de-trang">
    <h1>Đơn đặt hàng @Model.Ma</h1>
    <partial name="_HuyHieuTrangThai" model="Model.TrangThai" />
    <a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a>
</div>

<div class="the">
    <div class="row g-3">
        <div class="col-md-4"><div class="text-secondary small">Kho xuất</div>@Model.MaKho – @Model.TenKho</div>
        <div class="col-md-4">
            <div class="text-secondary small">Nơi nhận</div>@Model.MaNoiNhan – @Model.TenNoiNhan
            @if (!string.IsNullOrEmpty(Model.DiaChiNhan))
            {
                <div class="small text-secondary">@Model.DiaChiNhan</div>
            }
        </div>
        <div class="col-md-4"><div class="text-secondary small">Người tạo, ngày tạo</div>@Model.NguoiTao · @NgayGio(Model.NgayTao)</div>
        <div class="col-md-4"><div class="text-secondary small">Hạn giao</div>@(Model.HanGiao is null ? "Không đặt" : Ngay(Model.HanGiao))</div>
        @if (Model.MaLenh is not null)
        {
            <div class="col-md-4"><div class="text-secondary small">Lệnh xuất</div><a asp-controller="LenhXuat" asp-action="ChiTiet" asp-route-ma="@Model.MaLenh">@Model.MaLenh</a></div>
        }
        @if (!string.IsNullOrEmpty(Model.GhiChu))
        {
            <div class="col-md-8"><div class="text-secondary small">Ghi chú</div>@Model.GhiChu</div>
        }
    </div>
</div>

<div class="the">
    <h2>Dòng hàng</h2>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Hàng</th><th>Đơn vị</th><th class="so">Đặt</th><th class="so">Đã xuất (đơn vị chính)</th><th class="so">Khả dụng ở @Model.MaKho</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Dong)
                {
                    <tr>
                        <td><span class="fw-semibold">@d.MaBienThe</span><div class="small text-secondary">@d.TenHang</div></td>
                        <td>@d.TenDonVi</td>
                        <td class="so">@So(d.SoLuongDat)@if (d.HeSo > 1)
                            {
                                <div class="small text-secondary">= @So(d.SoDatChinh) @d.DonViChinh</div>
                            }</td>
                        <td class="so">@So(d.SoLuongDaXuat) @d.DonViChinh</td>
                        <td class="so @(Model.SuaDuoc && d.KhaDung < d.SoDatChinh - d.SoLuongDaXuat ? "text-danger fw-semibold" : null)">@So(d.KhaDung) @d.DonViChinh@if (d.KhaDungQuyDoi != $"{So(d.KhaDung)} {d.DonViChinh}")
                            {
                                <div class="small text-secondary">@d.KhaDungQuyDoi</div>
                            }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.SuaDuoc && Model.Dong.Any(d => d.KhaDung < d.SoDatChinh))
    {
        <p class="text-danger mt-2 mb-0">Có dòng khả dụng ít hơn số đặt (chữ đỏ): đơn sẽ không duyệt được nếu kho chưa có thêm hàng.</p>
    }
</div>

@if (Model.DaGiu.Count > 0)
{
    <div class="the">
        <h2>Hàng đã giữ</h2>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead><tr><th>#</th><th>Hàng</th><th>Lô</th><th>Hạn dùng</th><th>Ô</th><th class="so">Giữ</th></tr></thead>
                <tbody>
                    @foreach (var g in Model.DaGiu)
                    {
                        <tr>
                            <td>@g.ThuTu</td>
                            <td>@g.MaBienThe</td>
                            <td>@g.MaLo</td>
                            <td>@Ngay(g.HanDung)</td>
                            <td class="small">@g.MaViTri</td>
                            <td class="so">@So(g.SoLuong)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="text-secondary mt-2 mb-0">Lô, ô do gợi ý G1 chọn: hết hạn trước xuất trước, rồi nhập trước xuất trước, ít kệ phải ghé.</p>
    </div>
}

<div class="thanh-nut">
    @if (Model.SuaDuoc && laNguoiTao && choDatHang)
    {
        <a class="btn btn-outline-primary" asp-action="Sua" asp-route-ma="@Model.Ma">Sửa</a>
        @if (Model.TrangThai == TrangThaiDonDat.Nhap)
        {
            <form method="post" asp-action="GuiDuyet" asp-route-ma="@Model.Ma">
                <button type="submit" class="btn btn-primary">Gửi duyệt</button>
            </form>
        }
    }
    @if (quanLy && Model.TrangThai == TrangThaiDonDat.ChoDuyet)
    {
        <form method="post" asp-action="Duyet" data-xac-nhan="Duyệt đơn @Model.Ma và giữ hàng theo lô, ô do G1 chọn?">
            <input type="hidden" name="ma" value="@Model.Ma" />
            <button type="submit" class="btn btn-primary">Duyệt và giữ hàng</button>
        </form>
    }
    @if (quanLy && Model.TrangThai == TrangThaiDonDat.DaDuyet && ViewData["ThuKho"] is List<LuaChon> thuKho)
    {
        <form class="d-flex gap-2" method="post" asp-controller="LenhXuat" asp-action="Them">
            <input type="hidden" name="maDonDat" value="@Model.Ma" />
            <label class="visually-hidden" for="nguoiThucHien">Thủ kho thực hiện</label>
            <select class="form-select" id="nguoiThucHien" name="nguoiThucHien" required>
                <option value="">Chọn thủ kho</option>
                @foreach (var t in thuKho)
                {
                    <option value="@t.Ma">@t.Ten</option>
                }
            </select>
            <button type="submit" class="btn btn-primary text-nowrap">Lập lệnh xuất</button>
        </form>
    }
    @if (quanLy && Model.TrangThai == TrangThaiDonDat.DaDuyet)
    {
        <form method="post" asp-action="BoGiu" asp-route-ma="@Model.Ma" data-xac-nhan="Bỏ giữ hàng của đơn @Model.Ma? Hàng trả lại tồn khả dụng, đơn quay lại Chờ duyệt.">
            <button type="submit" class="btn btn-outline-secondary">Bỏ giữ</button>
        </form>
    }
    @if (Model.SuaDuoc || (quanLy && Model.TrangThai == TrangThaiDonDat.DaDuyet))
    {
        <form method="post" asp-action="Huy" asp-route-ma="@Model.Ma" data-xac-nhan="Hủy đơn đặt hàng @Model.Ma?@(Model.TrangThai == TrangThaiDonDat.DaDuyet ? " Hàng đã giữ được trả lại tồn khả dụng." : "")">
            <button type="submit" class="btn btn-outline-danger">Hủy đơn</button>
        </form>
    }
</div>
