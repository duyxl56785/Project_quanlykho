@using quanlykho.Common.PhanQuyen
@using quanlykho.Features.XuatKho
@model DonDatChiTiet
@{
    ViewData["Title"] = $"Đơn đặt hàng {Model.Ma}";
    var laNguoiTao = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value == Model.MaNguoiTao || User.IsInRole(Vai.QuanTri);
    var choDatHang = User.IsInRole(Vai.QuanTri) || User.IsInRole(Vai.BanHang);
}

<div class="tieu-de-trang">
    <h1>Đơn đặt hàng @Model.Ma</h1>
    <partial name="_HuyHieuTrangThai" model="Model.TrangThai" />
    <a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a>
</div>

<div class="the">
    <div class="row g-3">
        <div class="col-md-4"><div class="text-secondary small">Kho xuất</div>@Model.MaKho – @Model.TenKho</div>
        <div class="col-md-4">
            <div class="text-secondary small">Nơi nhận</div>@Model.MaNoiNhan – @Model.TenNoiNhan
            @if (!string.IsNullOrEmpty(Model.DiaChiNhan))
            {
                <div class="small text-secondary">@Model.DiaChiNhan</div>
            }
        </div>
        <div class="col-md-4"><div class="text-secondary small">Người tạo, ngày tạo</div>@Model.NguoiTao · @NgayGio(Model.NgayTao)</div>
        <div class="col-md-4"><div class="text-secondary small">Hạn giao</div>@(Model.HanGiao is null ? "Không đặt" : Ngay(Model.HanGiao))</div>
        @if (!string.IsNullOrEmpty(Model.GhiChu))
        {
            <div class="col-md-8"><div class="text-secondary small">Ghi chú</div>@Model.GhiChu</div>
        }
    </div>
</div>

<div class="the">
    <h2>Dòng hàng</h2>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead>
                <tr><th>Hàng</th><th>Đơn vị</th><th class="so">Đặt</th><th class="so">Đã xuất</th><th class="so">Khả dụng ở @Model.MaKho</th></tr>
            </thead>
            <tbody>
                @foreach (var d in Model.Dong)
                {
                    <tr>
                        <td><span class="fw-semibold">@d.MaBienThe</span><div class="small text-secondary">@d.TenHang</div></td>
                        <td>@d.TenDonVi</td>
                        <td class="so">@So(d.SoLuongDat)</td>
                        <td class="so">@So(d.SoLuongDaXuat)</td>
                        <td class="so @(d.KhaDung < d.SoDatChinh - d.SoLuongDaXuat ? "text-danger fw-semibold" : null)">@So(d.KhaDung)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.SuaDuoc && Model.Dong.Any(d => d.KhaDung < d.SoDatChinh))
    {
        <p class="text-danger mt-2 mb-0">Có dòng khả dụng ít hơn số đặt (chữ đỏ): đơn sẽ không duyệt được nếu kho chưa có thêm hàng.</p>
    }
</div>

<div class="thanh-nut">
    @if (Model.SuaDuoc && laNguoiTao && choDatHang)
    {
        <a class="btn btn-outline-primary" asp-action="Sua" asp-route-ma="@Model.Ma">Sửa</a>
        @if (Model.TrangThai == TrangThaiDonDat.Nhap)
        {
            <form method="post" asp-action="GuiDuyet" asp-route-ma="@Model.Ma">
                <button type="submit" class="btn btn-primary">Gửi duyệt</button>
            </form>
        }
    }
    @if (Model.SuaDuoc)
    {
        <form method="post" asp-action="Huy" asp-route-ma="@Model.Ma" data-xac-nhan="Hủy đơn đặt hàng @Model.Ma?">
            <button type="submit" class="btn btn-outline-danger">Hủy đơn</button>
        </form>
    }
</div>
