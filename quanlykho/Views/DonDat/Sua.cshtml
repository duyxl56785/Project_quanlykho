@model quanlykho.Features.XuatKho.DonDatForm
@{ ViewData["Title"] = $"Sửa đơn {Model.Ma}"; }

<div class="tieu-de-trang"><h1>Sửa đơn đặt hàng @Model.Ma</h1></div>

<form method="post" asp-action="Sua" asp-route-ma="@Model.Ma">
    <partial name="_Form" model="Model" />
    <div class="thanh-nut">
        <button type="submit" class="btn btn-primary">Lưu đơn</button>
        <a class="btn btn-outline-secondary" asp-action="ChiTiet" asp-route-ma="@Model.Ma">Quay lại</a>
    </div>
</form>
