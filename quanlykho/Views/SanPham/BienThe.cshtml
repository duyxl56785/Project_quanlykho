@using quanlykho.Common.PhanQuyen
@using quanlykho.Features.DanhMuc
@model BienTheForm
@{
    ViewData["Title"] = $"Biến thể {Model.Ma}";
    var laQuanTri = User.IsInRole(Vai.QuanTri);
}

<div class="tieu-de-trang">
    <h1>@Model.Ma – @Model.TenSanPham</h1>
    <partial name="_HuyHieuTrangThai" model="Model.TrangThai" />
    <a class="btn btn-outline-secondary" asp-action="Sua" asp-route-ma="@Model.MaSanPham">Về sản phẩm</a>
</div>

<form method="post" asp-action="BienThe" asp-route-ma="@Model.Ma">
    <fieldset disabled="@(!laQuanTri)">
        <div class="the bieu-mau">
            <h2>Thông tin biến thể</h2>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <p><span class="text-secondary">Thuộc tính:</span> @SinhBienThe.MoTa(Model.ThuocTinh)</p>
            <div class="row g-3">
                <div class="col-6 col-md-3"><label asp-for="DaiDongGoi" class="form-label bat-buoc"></label><input asp-for="DaiDongGoi" class="form-control" type="number" step="any" /><span asp-validation-for="DaiDongGoi"></span></div>
                <div class="col-6 col-md-3"><label asp-for="RongDongGoi" class="form-label bat-buoc"></label><input asp-for="RongDongGoi" class="form-control" type="number" step="any" /><span asp-validation-for="RongDongGoi"></span></div>
                <div class="col-6 col-md-3"><label asp-for="CaoDongGoi" class="form-label bat-buoc"></label><input asp-for="CaoDongGoi" class="form-control" type="number" step="any" /><span asp-validation-for="CaoDongGoi"></span></div>
                <div class="col-6 col-md-3"><label asp-for="KhoiLuong" class="form-label bat-buoc"></label><input asp-for="KhoiLuong" class="form-control" type="number" step="any" /><span asp-validation-for="KhoiLuong"></span></div>
                <div class="col-md-6"><label asp-for="MaVach" class="form-label"></label><input asp-for="MaVach" class="form-control" /><span asp-validation-for="MaVach"></span></div>
                <div class="col-md-6">
                    <label asp-for="TrangThai" class="form-label"></label>
                    <select asp-for="TrangThai" class="form-select">
                        @foreach (var t in Enum.GetValues<TrangThaiSuDung>())
                        {
                            <option value="@t" selected="@(t == Model.TrangThai)">@TrangThaiHienThi.Lay(t).Ten</option>
                        }
                    </select>
                </div>
            </div>
            <p class="form-text mt-2 mb-0">Kích thước và khối lượng của một @Model.DonViTinh, dùng để kiểm sức chứa ô khi xếp hàng.</p>
        </div>

        <div class="the bieu-mau">
            <h2>Mức tồn theo kho</h2>
            <p class="form-text">Để trống tối thiểu và tối đa nếu không theo dõi ở kho đó. Thời gian chờ hàng dùng cho đề xuất nhập bổ sung.</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Kho</th><th>Tồn tối thiểu</th><th>Tồn tối đa</th><th>Chờ hàng (ngày)</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < Model.MucTon.Count; i++)
                        {
                            <tr>
                                <td><input type="hidden" asp-for="MucTon[i].MaKho" />@Model.MucTon[i].MaKho – @Model.MucTon[i].TenKho</td>
                                <td><input asp-for="MucTon[i].ToiThieu" class="form-control" type="number" step="any" min="0" aria-label="Tồn tối thiểu" /></td>
                                <td><input asp-for="MucTon[i].ToiDa" class="form-control" type="number" step="any" min="0" aria-label="Tồn tối đa" /></td>
                                <td><input asp-for="MucTon[i].ThoiGianChoHang" class="form-control" type="number" min="0" aria-label="Thời gian chờ hàng" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="the bieu-mau">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
                <h2 class="mb-0">Đơn vị quy đổi</h2>
                @if (laQuanTri)
                {
                    <button type="button" class="btn btn-outline-primary" data-them-dong="#donVi">+ Thêm đơn vị</button>
                }
            </div>
            <p class="form-text">Một tầng so với đơn vị tính chính (@Model.DonViTinh), hệ số nguyên lớn hơn 1, ví dụ 1 thùng = 24 @Model.DonViTinh. Tồn và sổ sách luôn tính theo @Model.DonViTinh. Đơn vị đã có trên chứng từ chỉ được ngừng sử dụng.</p>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead><tr><th>Tên đơn vị</th><th>1 đơn vị = ? @Model.DonViTinh</th><th>Mã vạch</th><th>Trạng thái</th><th></th></tr></thead>
                    <tbody id="donVi" data-dong-hang>
                        @for (var i = 0; i < Model.DonVi.Count; i++)
                        {
                            <tr>
                                <td><input class="form-control" name="DonVi[@i].TenDonVi" value="@Model.DonVi[i].TenDonVi" maxlength="20" required aria-label="Tên đơn vị" /></td>
                                <td><input class="form-control text-end" name="DonVi[@i].HeSo" value="@Model.DonVi[i].HeSo.ToString("G29")" type="number" min="2" step="1" required aria-label="Hệ số" /></td>
                                <td><input class="form-control" name="DonVi[@i].MaVach" value="@Model.DonVi[i].MaVach" maxlength="64" aria-label="Mã vạch đơn vị" /></td>
                                <td>
                                    <select class="form-select" name="DonVi[@i].TrangThai" aria-label="Trạng thái đơn vị">
                                        @foreach (var t in Enum.GetValues<TrangThaiSuDung>())
                                        {
                                            <option value="@t" selected="@(t == Model.DonVi[i].TrangThai)">@TrangThaiHienThi.Lay(t).Ten</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" data-xoa-dong aria-label="Xóa đơn vị">✕</button></td>
                            </tr>
                        }
                    </tbody>
                    <template>
                        <tr>
                            <td><input class="form-control" name="DonVi[__i__].TenDonVi" maxlength="20" required placeholder="thùng" aria-label="Tên đơn vị" /></td>
                            <td><input class="form-control text-end" name="DonVi[__i__].HeSo" type="number" min="2" step="1" required placeholder="24" aria-label="Hệ số" /></td>
                            <td><input class="form-control" name="DonVi[__i__].MaVach" maxlength="64" aria-label="Mã vạch đơn vị" /></td>
                            <td>
                                <select class="form-select" name="DonVi[__i__].TrangThai" aria-label="Trạng thái đơn vị">
                                    @foreach (var t in Enum.GetValues<TrangThaiSuDung>())
                                    {
                                        <option value="@t">@TrangThaiHienThi.Lay(t).Ten</option>
                                    }
                                </select>
                            </td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" data-xoa-dong aria-label="Xóa đơn vị">✕</button></td>
                        </tr>
                    </template>
                </table>
            </div>
            @if (Model.DonVi.Count == 0)
            {
                <p class="text-secondary mt-2 mb-0">Chưa có đơn vị quy đổi.</p>
            }
        </div>

        @if (laQuanTri)
        {
            <div class="thanh-nut"><button type="submit" class="btn btn-primary">Lưu</button></div>
        }
    </fieldset>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
