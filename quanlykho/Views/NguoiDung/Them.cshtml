@model quanlykho.Features.QuanLyNguoiDung.NguoiDungForm
@{
    ViewData["Title"] = "Thêm người dùng";
}

<div class="tieu-de-trang">
    <h1>Thêm người dùng</h1>
</div>

<form class="the bieu-mau" method="post" asp-action="Them">
    <partial name="_Form" model="Model" />
    <div class="row g-3 mt-0">
        <div class="col-md-6">
            <label asp-for="MatKhau" class="form-label bat-buoc"></label>
            <input asp-for="MatKhau" class="form-control" autocomplete="new-password" />
            <div class="form-text">Ít nhất 8 ký tự, gồm cả chữ và số.</div>
        </div>
    </div>
    <div class="thanh-nut mt-4">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Hủy bỏ</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
