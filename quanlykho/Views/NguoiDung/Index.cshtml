@using quanlykho.Common.PhanQuyen
@model TrangDuLieu<quanlykho.Features.QuanLyNguoiDung.NguoiDungDong>
@{
    ViewData["Title"] = "Người dùng";
    var vaiChon = ViewData["VaiTro"] as VaiTro?;
    var trangThaiChon = ViewData["TrangThai"] as TrangThaiTaiKhoan?;
}

<div class="tieu-de-trang">
    <h1>Người dùng</h1>
    <a class="btn btn-primary" asp-action="Them">Thêm người dùng</a>
</div>

<form class="thanh-loc" method="get">
    <div>
        <label class="form-label" for="tuKhoa">Tìm kiếm</label>
        <input class="form-control" id="tuKhoa" name="tuKhoa" value="@ViewData["TuKhoa"]" placeholder="Mã, tên, email" />
    </div>
    <div>
        <label class="form-label" for="vaiTro">Vai trò</label>
        <select class="form-select" id="vaiTro" name="vaiTro">
            <option value="">Tất cả</option>
            @foreach (var v in Enum.GetValues<VaiTro>())
            {
                <option value="@v" selected="@(v == vaiChon)">@Vai.TenHienThi(v)</option>
            }
        </select>
    </div>
    <div>
        <label class="form-label" for="trangThai">Trạng thái</label>
        <select class="form-select" id="trangThai" name="trangThai">
            <option value="">Tất cả</option>
            @foreach (var t in Enum.GetValues<TrangThaiTaiKhoan>())
            {
                <option value="@t" selected="@(t == trangThaiChon)">@TrangThaiHienThi.Lay(t).Ten</option>
            }
        </select>
    </div>
    <div class="thanh-loc-nut thanh-nut">
        <button class="btn btn-primary" type="submit">Lọc</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Bỏ lọc</a>
    </div>
</form>

<bang-du-lieu trang="Model" thong-bao-rong="Không có người dùng nào khớp bộ lọc.">
    <thead>
        <tr><th>Mã</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Kho</th><th>Trạng thái</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var n in Model.Muc)
        {
            <tr>
                <td class="fw-semibold">@n.Ma</td>
                <td>@n.Ten</td>
                <td>@n.Email</td>
                <td>@Vai.TenHienThi(n.VaiTro)</td>
                <td>@(n.Kho.Count == 0 ? "Mọi kho" : string.Join(", ", n.Kho))</td>
                <td>
                    <partial name="_HuyHieuTrangThai" model="n.TrangThai" />
                    @if (n.KhoaDenLuc > DateTimeOffset.UtcNow)
                    {
                        <span class="trang-thai trang-thai-vang">Khóa tạm đến @NgayGio(n.KhoaDenLuc)</span>
                    }
                </td>
                <td class="text-end"><a class="btn btn-sm btn-outline-secondary" asp-action="Sua" asp-route-ma="@n.Ma">Sửa</a></td>
            </tr>
        }
    </tbody>
</bang-du-lieu>
