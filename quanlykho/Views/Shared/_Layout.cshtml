@using quanlykho.Common.PhanQuyen
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    var duongDan = Context.Request.Path.Value ?? "/";
    bool DangMo(string url) => url == "/" ? duongDan == "/" : duongDan.StartsWith(url, StringComparison.OrdinalIgnoreCase);
    bool DuocXem(MucMenu muc) => muc.VaiTro is null || muc.VaiTro.Any(v => User.IsInRole(v.ToString()));
    var vaiHienTai = Enum.TryParse<VaiTro>(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value, out var v) ? Vai.TenHienThi(v) : "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* fetch tới API gửi kèm token này ở header RequestVerificationToken (site.js). *@
    <meta name="xsrf-token" content="@Antiforgery.GetAndStoreTokens(Context).RequestToken" />
    <title>@ViewData["Title"] - Quản lý kho</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="khung">
        <aside class="thanh-menu offcanvas-lg offcanvas-start" tabindex="-1" id="thanhMenu" aria-label="Menu chính">
            <div class="d-flex align-items-center">
                <a class="ten-he-thong" href="/">Quản lý kho</a>
                <button type="button" class="btn-close btn-close-white ms-auto me-3 d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#thanhMenu" aria-label="Đóng menu"></button>
            </div>
            <nav class="pb-3">
                @foreach (var nhom in Menu.TatCa.Where(n => n.Muc.Any(DuocXem)))
                {
                    <div class="nhom">@nhom.Ten</div>
                    <ul class="nav flex-column">
                        @foreach (var muc in nhom.Muc.Where(DuocXem))
                        {
                            <li class="nav-item">
                                @if (muc.Url is null)
                                {
                                    <span class="nav-link disabled" aria-disabled="true">@muc.Ten</span>
                                }
                                else
                                {
                                    <a class="nav-link @(DangMo(muc.Url) ? "active" : "")" href="@muc.Url" aria-current="@(DangMo(muc.Url) ? "page" : null)">@muc.Ten@if (muc.Dem is not null)
                                    {
                                        <span class="dem-viec" data-dem="@muc.Dem" hidden></span>
                                    }</a>
                                }
                            </li>
                        }
                    </ul>
                }
            </nav>
        </aside>

        <div class="noi-dung">
            <header class="thanh-tren">
                <button class="btn btn-outline-secondary d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#thanhMenu" aria-controls="thanhMenu" aria-label="Mở menu">☰</button>
                <p class="tieu-de">@ViewData["Title"]</p>
                <div class="nguoi-dung">
                    <span class="d-none d-sm-inline">@User.Identity?.Name <span class="d-none d-md-inline">· @vaiHienTai</span></span>
                    <form method="post" asp-controller="TaiKhoan" asp-action="DangXuat" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-secondary ms-2">Đăng xuất</button>
                    </form>
                </div>
            </header>
            <main role="main">
                <partial name="_ThongBao" />
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_HopXacNhan" />
    <partial name="_HopCamera" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
