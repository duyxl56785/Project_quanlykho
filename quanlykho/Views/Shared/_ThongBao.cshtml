@* Thông báo sau khi chuyển trang: controller gán TempData["ThongBao"] (thành công) hoặc TempData["Loi"]. *@
@if (TempData["ThongBao"] is string thongBao)
{
    <div class="alert alert-success alert-dismissible" role="status">
        @thongBao
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger alert-dismissible" role="alert">
        @loi
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
