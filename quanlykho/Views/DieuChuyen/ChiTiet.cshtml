@using quanlykho.Common.PhanQuyen
@using quanlykho.Features.DieuChuyen
@model DieuChuyenChiTiet
@{
    ViewData["Title"] = $"Phiếu điều chuyển {Model.Ma}";
    var quanLy = User.IsInRole(Vai.QuanTri) || User.IsInRole(Vai.QuanLyKho);
    var nhanDuoc = Model.LaKhoDen && Model.TrangThai == TrangThaiDieuChuyen.ChoNhapKho;
}

<div class="@(nhanDuoc ? "man-hinh-quet" : null)">
    <div class="tieu-de-trang">
        <h1>Phiếu điều chuyển @Model.Ma</h1>
        <partial name="_HuyHieuTrangThai" model="Model.TrangThai" />
        <a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a>
    </div>

    <div class="the">
        <div class="row g-3">
            <div class="col-md-4"><div class="text-secondary small">Kho đi → kho đến</div><span class="fw-semibold">@Model.MaKhoDi – @Model.TenKhoDi → @Model.MaKhoDen – @Model.TenKhoDen</span></div>
            <div class="col-md-4"><div class="text-secondary small">Ngày chuyển, phương tiện</div>@Ngay(Model.NgayChuyen)@(string.IsNullOrEmpty(Model.PhuongTien) ? "" : $" · {Model.PhuongTien}")@(string.IsNullOrEmpty(Model.NguoiVanChuyen) ? "" : $" · {Model.NguoiVanChuyen}")</div>
            <div class="col-md-4"><div class="text-secondary small">Người lập</div>@Model.NguoiLap · @NgayGio(Model.NgayLap)</div>
            @if (Model.ThoiDiemXuat is not null)
            {
                <div class="col-md-4"><div class="text-secondary small">Xuất khỏi kho đi</div>@NgayGio(Model.ThoiDiemXuat)</div>
            }
            @if (Model.NguoiNhan is not null)
            {
                <div class="col-md-4"><div class="text-secondary small">Người nhận</div>@Model.NguoiNhan · @NgayGio(Model.ThoiDiemNhan)</div>
            }
            @if (!string.IsNullOrEmpty(Model.LyDo))
            {
                <div class="col-md-4"><div class="text-secondary small">Lý do</div>@Model.LyDo</div>
            }
        </div>
    </div>

    <form method="post" asp-action="Nhan" asp-route-ma="@Model.Ma"
          data-xac-nhan="Xác nhận đã nhận hàng theo số thực nhận? Hàng vào khu tiếp nhận kho @Model.MaKhoDen; dòng nhận thiếu thành chênh lệch chờ xử lý.">
        <input type="hidden" name="khoaChongLap" value="@Guid.NewGuid().ToString("N")" />
        <div class="the">
            <h2>Hàng chuyển</h2>
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>#</th><th>Hàng</th><th>Lô</th><th>Hạn dùng</th><th>Ô ở kho đi</th><th class="so">Chuyển</th>
                            <th class="so">Thực nhận</th>
                            @if (Model.Dong.Any(d => d.ChenhLech > 0))
                            {
                                <th class="so">Chênh lệch</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Dong.Count; i++)
                        {
                            var d = Model.Dong[i];
                            <tr>
                                <td>@d.STT</td>
                                <td><span class="fw-semibold">@d.MaBienThe</span><div class="small text-secondary">@d.TenHang</div></td>
                                <td>@d.MaLo</td>
                                <td>@Ngay(d.HanDung)</td>
                                <td class="small">@d.MaViTriDi</td>
                                <td class="so">@So(d.SoLuong) @d.TenDonVi</td>
                                <td class="so">
                                    @if (nhanDuoc)
                                    {
                                        <input type="hidden" name="nhan[@i].STT" value="@d.STT" />
                                        <input class="form-control text-end" name="nhan[@i].SoLuongNhan" type="number" min="0" max="@d.SoLuong" step="any" value="@d.SoLuong.ToString("G29")" aria-label="Thực nhận dòng @d.STT" />
                                    }
                                    else
                                    {
                                        @So(d.SoLuongNhan)
                                    }
                                </td>
                                @if (Model.Dong.Any(x => x.ChenhLech > 0))
                                {
                                    <td class="so @(d.ChoXuLy ? "text-danger fw-semibold" : null)">
                                    @(d.ChenhLech > 0 ? $"−{So(d.ChenhLech)}" : "")
                                    @if (d.CachXuLy is { } cach)
                                    {
                                        <div class="small text-secondary">@DongDieuChuyen.TenCach(cach): @d.LyDoXuLy</div>
                                    }
                                </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TrangThai == TrangThaiDieuChuyen.NhanMotPhan)
            {
                <p class="text-danger mt-2 mb-0">Nhận thiếu so với số chuyển: phần thiếu là chênh lệch chờ quản lý kho xử lý (nhập tại kho đến, nhập lại kho đi hoặc ghi giảm hao hụt).</p>
            }
            @if (Model.TrangThai is TrangThaiDieuChuyen.ChoNhapKho)
            {
                <p class="text-secondary mt-2 mb-0">Hàng đang vận chuyển: đã trừ ở kho đi, chưa vào tồn kho đến.</p>
            }
        </div>
        @if (nhanDuoc)
        {
            <div class="thanh-nut mb-3">
                <button type="submit" class="btn btn-primary flex-grow-1">Xác nhận nhận hàng</button>
            </div>
        }
    </form>

    @if (quanLy && Model.TrangThai == TrangThaiDieuChuyen.NhanMotPhan)
    {
        <div class="the">
            <h2>Xử lý chênh lệch</h2>
            @foreach (var d in Model.Dong.Where(x => x.ChoXuLy))
            {
                <form method="post" asp-action="XuLy" asp-route-ma="@Model.Ma" class="row g-2 align-items-end mb-2"
                      data-xac-nhan="Xử lý phần thiếu @So(d.ChenhLech) @d.TenDonVi của lô @d.MaLo? Không hoàn tác được.">
                    <input type="hidden" name="stt" value="@d.STT" />
                    <input type="hidden" name="khoaChongLap" value="@Guid.NewGuid().ToString("N")" />
                    <div class="col-md-3"><div class="small text-secondary">Dòng @d.STT · @d.MaLo</div><span class="fw-semibold text-danger">Thiếu @So(d.ChenhLech) @d.TenDonVi</span></div>
                    <div class="col-md-3">
                        <label class="form-label" for="cach-@d.STT">Cách xử lý</label>
                        <select class="form-select" id="cach-@d.STT" name="cachXuLy">
                            @if (Model.LaKhoDen)
                            {
                                <option value="@XuLyChenhLech.NhapKhoDen">@DongDieuChuyen.TenCach(XuLyChenhLech.NhapKhoDen)</option>
                            }
                            @if (Model.LaKhoDi)
                            {
                                <option value="@XuLyChenhLech.NhapLaiKhoDi">@DongDieuChuyen.TenCach(XuLyChenhLech.NhapLaiKhoDi)</option>
                            }
                            <option value="@XuLyChenhLech.GhiGiamHaoHut">@DongDieuChuyen.TenCach(XuLyChenhLech.GhiGiamHaoHut)</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label bat-buoc" for="lyDo-@d.STT">Lý do</label>
                        <input class="form-control" id="lyDo-@d.STT" name="lyDo" required placeholder="Tìm thấy trên xe, rơi vỡ dọc đường…" />
                    </div>
                    <div class="col-md-2"><button type="submit" class="btn btn-primary w-100">Xử lý</button></div>
                </form>
            }
            <p class="form-text mb-0">Nhập tại kho đến: hàng tìm thấy, cộng vào khu tiếp nhận kho đến. Nhập lại kho đi: hàng chưa rời kho đi, cộng trả đúng ô cũ. Ghi giảm hao hụt: hàng mất, đóng dòng, tổng tồn giảm đúng số thiếu.</p>
        </div>
    }

    <div class="thanh-nut">
        @if (Model.LaKhoDi && quanLy && Model.TrangThai == TrangThaiDieuChuyen.LuuTam)
        {
            <a class="btn btn-outline-primary" asp-action="Sua" asp-route-ma="@Model.Ma">Sửa</a>
            <form method="post" asp-action="Luu" asp-route-ma="@Model.Ma" data-xac-nhan="Lưu phiếu và trừ hàng ở kho @Model.MaKhoDi?">
                <input type="hidden" name="khoaChongLap" value="@Guid.NewGuid().ToString("N")" />
                <button type="submit" class="btn btn-primary">Lưu, xuất kho đi</button>
            </form>
        }
        @if (Model.LaKhoDi && quanLy && Model.TrangThai is TrangThaiDieuChuyen.LuuTam or TrangThaiDieuChuyen.ChoNhapKho)
        {
            <form method="post" asp-action="Huy" asp-route-ma="@Model.Ma"
                  data-xac-nhan="Hủy phiếu @Model.Ma?@(Model.TrangThai == TrangThaiDieuChuyen.ChoNhapKho ? " Hàng được cộng trả về đúng ô ở kho đi." : "")">
                <button type="submit" class="btn btn-outline-danger">Hủy phiếu</button>
            </form>
        }
        @if (Model.LaKhoDen && Model.TrangThai is TrangThaiDieuChuyen.HoanThanh or TrangThaiDieuChuyen.NhanMotPhan)
        {
            <a class="btn btn-outline-primary" asp-controller="XepHang" asp-action="Index" asp-route-maKho="@Model.MaKhoDen">Xếp hàng vào kệ</a>
        }
    </div>
</div>
