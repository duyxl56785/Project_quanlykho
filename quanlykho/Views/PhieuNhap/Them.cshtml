@using quanlykho.Features.NhapKho
@model PhieuNhapForm
@{ ViewData["Title"] = "Lập hóa đơn nhập"; }

<div class="tieu-de-trang"><h1>Lập hóa đơn nhập</h1></div>

<form method="post" asp-action="Them">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
    <div class="the">
        <fieldset class="mb-3">
            <legend class="form-label fs-6">Loại phiếu</legend>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="LoaiPhieu" value="@LoaiPhieuNhap.MuaHang" id="loaiMuaHang" />
                <label class="form-check-label" for="loaiMuaHang">Nhận hàng theo đơn mua</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" asp-for="LoaiPhieu" value="@LoaiPhieuNhap.NhapKhac" id="loaiNhapKhac" />
                <label class="form-check-label" for="loaiNhapKhac">Nhập khác (không có đơn mua)</label>
            </div>
        </fieldset>
        <div class="row g-3">
            <div class="col-md-6" data-loai="MuaHang">
                <label asp-for="MaDonMua" class="form-label bat-buoc"></label>
                <select asp-for="MaDonMua" class="form-select">
                    <option value="">Chọn đơn mua</option>
                    @foreach (var d in Model.DanhSachDonMua)
                    {
                        <option value="@d.Ma" selected="@(d.Ma == Model.MaDonMua)">@d.Ten</option>
                    }
                </select>
                @if (Model.DanhSachDonMua.Count == 0)
                {
                    <div class="form-text">Không có đơn mua nào đang chờ nhận hàng ở kho của bạn.</div>
                }
            </div>
            <div class="col-md-6" data-loai="NhapKhac">
                <label asp-for="MaKho" class="form-label bat-buoc"></label>
                @await Component.InvokeAsync("OChonKho", new { ten = nameof(Model.MaKho), chon = Model.MaKho, danhSach = Model.DanhSachKho })
            </div>
            <div class="col-12">
                <label asp-for="GhiChu" class="form-label"></label>
                <input asp-for="GhiChu" class="form-control" />
            </div>
        </div>
    </div>
    <div class="thanh-nut">
        <button type="submit" class="btn btn-primary">Lập và bắt đầu nhận hàng</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Hủy bỏ</a>
    </div>
</form>

<script>
    (() => {
        const hien = () => {
            const loai = document.querySelector('[name="LoaiPhieu"]:checked').value;
            document.querySelectorAll("[data-loai]").forEach((k) => k.hidden = k.dataset.loai !== loai);
        };
        document.querySelectorAll('[name="LoaiPhieu"]').forEach((r) => r.addEventListener("change", hien));
        hien();
    })();
</script>
