@using quanlykho.Features.XuatKho
@model PhieuXuatChiTiet
@{
    ViewData["Title"] = $"Phiếu xuất {Model.Ma}";
    var loai = Model.LoaiPhieu switch
    {
        LoaiPhieuXuat.XuatBan => "Xuất bán",
        LoaiPhieuXuat.TraNhaCungCap => "Trả nhà cung cấp",
        _ => "Xuất khác",
    };
}

<div class="tieu-de-trang">
    <h1>Phiếu xuất @Model.Ma</h1>
    <partial name="_HuyHieuTrangThai" model="Model.TrangThai" />
    <a class="btn btn-outline-secondary" asp-action="Index">Danh sách</a>
</div>

<div class="the">
    <div class="row g-3">
        <div class="col-md-4">
            <div class="text-secondary small">Loại phiếu</div>@loai
            @if (Model.MaLenh is not null)
            {
                <span>· <a asp-controller="LenhXuat" asp-action="ChiTiet" asp-route-ma="@Model.MaLenh">@Model.MaLenh</a></span>
            }
        </div>
        <div class="col-md-4"><div class="text-secondary small">Kho xuất</div>@Model.MaKho – @Model.TenKho</div>
        <div class="col-md-4"><div class="text-secondary small">Ngày xuất</div>@NgayGio(Model.NgayXuat)</div>
        <div class="col-md-4"><div class="text-secondary small">Người lập, người xác nhận</div>@Model.NguoiLap · @Model.NguoiXacNhan</div>
        @if (Model.NhaCungCap is not null)
        {
            <div class="col-md-4"><div class="text-secondary small">Nhà cung cấp</div>@Model.NhaCungCap</div>
        }
        @if (!string.IsNullOrEmpty(Model.LyDo))
        {
            <div class="col-md-4"><div class="text-secondary small">Lý do</div>@Model.LyDo</div>
        }
    </div>
</div>

<div class="the">
    <h2>Hàng xuất</h2>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead><tr><th>#</th><th>Hàng</th><th>Lô</th><th>Hạn dùng</th><th>Ô</th><th class="so">Số lượng</th></tr></thead>
            <tbody>
                @foreach (var d in Model.Dong)
                {
                    <tr>
                        <td>@d.STT</td>
                        <td><span class="fw-semibold">@d.MaBienThe</span><div class="small text-secondary">@d.TenHang</div></td>
                        <td>@d.MaLo</td>
                        <td>@Ngay(d.HanDung)</td>
                        <td class="small">@d.MaViTri</td>
                        <td class="so">@So(d.SoLuongGoc) @d.TenDonVi@if (d.HeSo > 1)
                            {
                                <div class="small text-secondary">= @So(d.SoLuong) @d.DonViChinh</div>
                            }</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
